<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Inicio compra">
      <bpmn:outgoing>Flow_StartToVerificarEdad</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_VerificarEdad" name="Verificar edad (KYC)">
      <bpmn:documentation>FR-006</bpmn:documentation>
      <bpmn:incoming>Flow_StartToVerificarEdad</bpmn:incoming>
      <bpmn:outgoing>Flow_VerificarEdadToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_EdadValida" name="¿Edad válida?">
      <bpmn:incoming>Flow_VerificarEdadToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayToCrearPaymentIntent</bpmn:outgoing>
      <bpmn:outgoing>Flow_GatewayToEndEdadNoValida</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_EdadNoValida" name="Edad no verificada">
      <bpmn:incoming>Flow_GatewayToEndEdadNoValida</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CrearPaymentIntent" name="Crear PaymentIntent Stripe">
      <bpmn:documentation>FR-004</bpmn:documentation>
      <bpmn:incoming>Flow_GatewayToCrearPaymentIntent</bpmn:incoming>
      <bpmn:outgoing>Flow_CrearPaymentIntentToProcesarWebhook</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ProcesarWebhook" name="Procesar webhook y generar entrada">
      <bpmn:documentation>FR-004,FR-001</bpmn:documentation>
      <bpmn:incoming>Flow_CrearPaymentIntentToProcesarWebhook</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcesarWebhookToEmitirToken</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_EmitirToken" name="Emitir token BLE en app">
      <bpmn:documentation>FR-001</bpmn:documentation>
      <bpmn:incoming>Flow_ProcesarWebhookToEmitirToken</bpmn:incoming>
      <bpmn:outgoing>Flow_EmitirTokenToEscanear</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Escanear" name="Escaneo y filtrado BLE por portero">
      <bpmn:documentation>FR-002</bpmn:documentation>
      <bpmn:incoming>Flow_EmitirTokenToEscanear</bpmn:incoming>
      <bpmn:outgoing>Flow_EscanearToValidar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Validar" name="Validar token y actualizar aforo">
      <bpmn:documentation>FR-003</bpmn:documentation>
      <bpmn:incoming>Flow_EscanearToValidar</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidarToFin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Acceso" name="Acceso concedido">
      <bpmn:incoming>Flow_ValidarToFin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToVerificarEdad" sourceRef="StartEvent_1" targetRef="Task_VerificarEdad"/>
    <bpmn:sequenceFlow id="Flow_VerificarEdadToGateway" sourceRef="Task_VerificarEdad" targetRef="Gateway_EdadValida"/>
    <bpmn:sequenceFlow id="Flow_GatewayToCrearPaymentIntent" sourceRef="Gateway_EdadValida" targetRef="Task_CrearPaymentIntent" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_GatewayToEndEdadNoValida" sourceRef="Gateway_EdadValida" targetRef="EndEvent_EdadNoValida" name="No"/>
    <bpmn:sequenceFlow id="Flow_CrearPaymentIntentToProcesarWebhook" sourceRef="Task_CrearPaymentIntent" targetRef="Task_ProcesarWebhook"/>
    <bpmn:sequenceFlow id="Flow_ProcesarWebhookToEmitirToken" sourceRef="Task_ProcesarWebhook" targetRef="Task_EmitirToken"/>
    <bpmn:sequenceFlow id="Flow_EmitirTokenToEscanear" sourceRef="Task_EmitirToken" targetRef="Task_Escanear"/>
    <bpmn:sequenceFlow id="Flow_EscanearToValidar" sourceRef="Task_Escanear" targetRef="Task_Validar"/>
    <bpmn:sequenceFlow id="Flow_ValidarToFin" sourceRef="Task_Validar" targetRef="EndEvent_Acceso"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_VerificarEdad" bpmnElement="Task_VerificarEdad">
        <dc:Bounds x="330" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_EdadValida" bpmnElement="Gateway_EdadValida">
        <dc:Bounds x="480" y="175" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_EdadNoValida" bpmnElement="EndEvent_EdadNoValida">
        <dc:Bounds x="480" y="300" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CrearPaymentIntent" bpmnElement="Task_CrearPaymentIntent">
        <dc:Bounds x="580" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ProcesarWebhook" bpmnElement="Task_ProcesarWebhook">
        <dc:Bounds x="730" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EmitirToken" bpmnElement="Task_EmitirToken">
        <dc:Bounds x="880" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Escanear" bpmnElement="Task_Escanear">
        <dc:Bounds x="1030" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Validar" bpmnElement="Task_Validar">
        <dc:Bounds x="1180" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Acceso" bpmnElement="EndEvent_Acceso">
        <dc:Bounds x="1330" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_StartToVerificarEdad" bpmnElement="Flow_StartToVerificarEdad">
        <di:waypoint x="216" y="200"/>
        <di:waypoint x="330" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_VerificarEdadToGateway" bpmnElement="Flow_VerificarEdadToGateway">
        <di:waypoint x="430" y="200"/>
        <di:waypoint x="480" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_GatewayToCrearPaymentIntent" bpmnElement="Flow_GatewayToCrearPaymentIntent">
        <di:waypoint x="530" y="200"/>
        <di:waypoint x="580" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_GatewayToEndEdadNoValida" bpmnElement="Flow_GatewayToEndEdadNoValida">
        <di:waypoint x="505" y="225"/>
        <di:waypoint x="505" y="300"/>
        <di:waypoint x="498" y="318"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CrearPaymentIntentToProcesarWebhook" bpmnElement="Flow_CrearPaymentIntentToProcesarWebhook">
        <di:waypoint x="680" y="200"/>
        <di:waypoint x="730" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ProcesarWebhookToEmitirToken" bpmnElement="Flow_ProcesarWebhookToEmitirToken">
        <di:waypoint x="830" y="200"/>
        <di:waypoint x="880" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_EmitirTokenToEscanear" bpmnElement="Flow_EmitirTokenToEscanear">
        <di:waypoint x="980" y="200"/>
        <di:waypoint x="1030" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_EscanearToValidar" bpmnElement="Flow_EscanearToValidar">
        <di:waypoint x="1130" y="200"/>
        <di:waypoint x="1180" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ValidarToFin" bpmnElement="Flow_ValidarToFin">
        <di:waypoint x="1280" y="200"/>
        <di:waypoint x="1330" y="200"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>